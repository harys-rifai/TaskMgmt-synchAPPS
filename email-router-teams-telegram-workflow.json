            {
              "value1": "={{ $json.route }}",
              "operation": "equal",
              "value2": "general"
            }
          ]
        }
      },
      "id": "switch-general",
      "name": "General",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 1000]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/teams/{{ $json.team_id }}/channels/{{ $json.channel_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": {\n    \"content\": \"<h3>New Task Created</h3>\\n<p><b>Job ID:</b> {{ $json.job_id }}</p>\\n<p><b>Priority:</b> {{ $json.priority }}</p>\\n<p><b>Assign To:</b> {{ $json.assign_to }}</p>\\n<p><b>Subject:</b> {{ $json.subject }}</p>\\n<p><b>Detail:</b> {{ $json.task_detail }}</p>\"\n  }\n}",
        "options": {}
      },
      "id": "teams-notification",
      "name": "Teams Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1100, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{ $json.telegram_token }}/sendMessage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.telegram_chat_id }}\",\n  \"text\": \"New Task Created\\n\\nJob ID: {{ $json.job_id }}\\nPriority: {{ $json.priority }}\\nAssign To: {{ $json.assign_to }}\\nSubject: {{ $json.subject }}\\nDetail: {{ $json.task_detail }}\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "id": "telegram-notification",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/task-api/tasks/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.job_id }}\",\n  \"email_from\": \"{{ $json.from }}\",\n  \"email_subject\": \"{{ $json.subject }}\",\n  \"task_type\": \"{{ $json.task_type }}\",\n  \"task_detail\": \"{{ $json.body }}\",\n  \"priority\": \"{{ $json.priority }}\",\n  \"status\": \"Open\"\n}",
        "options": {}
      },
      "id": "django-api",
      "name": "Send to Django API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1100, 550]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  results.push({\n    json: {\n      ...item.json,\n      job_id: 'JOB-' + new Date().toISOString().slice(0,10).replace(/-/g,'') + '-' + String(Math.floor(Math.random()*10000)).padStart(4,'0'),\n      assign_to: item.json.assign_to || 'Unassigned',\n      task_detail: item.json.body || item.json.task_detail || '',\n    }\n  });\n}\nreturn results;"
      },
      "id": "format-task",
      "name": "Format Task Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 550]
    }
  ],
