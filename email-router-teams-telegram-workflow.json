{
  "name": "Email → Router → Teams + Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "folderId": "inbox",
          "subject": ""
        },
        "options": {}
      },
      "id": "outlook-trigger",
      "name": "Outlook Trigger",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "outlook-credential",
          "name": "Outlook Shared Mailbox"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\nconst subject = email.subject || '';\nconst body = email.body || '';\nconst from = email.from || '';\n\nlet priority = 'Low';\nlet route = 'general';\n\nconst subjectLower = subject.toLowerCase();\nconst bodyLower = body.toLowerCase();\n\nif (subjectLower.includes('urgent') || subjectLower.includes('critical') || bodyLower.includes('urgent') || bodyLower.includes('critical')) {\n  priority = 'High';\n  route = 'high';\n} else if (subjectLower.includes('sap') || bodyLower.includes('sap')) {\n  priority = 'High';\n  route = 'sap';\n} else if (subjectLower.includes('database') || bodyLower.includes('database') || subjectLower.includes('dba') || bodyLower.includes('dba')) {\n  priority = 'Medium';\n  route = 'database';\n} else if (subjectLower.includes('vpn') || bodyLower.includes('vpn')) {\n  priority = 'Medium';\n  route = 'network';\n} else if (subjectLower.includes('laptop') || bodyLower.includes('laptop') || subjectLower.includes('hardware') || bodyLower.includes('hardware')) {\n  priority = 'Medium';\n  route = 'it';\n} else if (subjectLower.includes('application') || bodyLower.includes('application') || subjectLower.includes('app') || bodyLower.includes('app')) {\n  priority = 'Low';\n  route = 'app';\n}\n\nreturn [{\n  json: {\n    ...email,\n    priority,\n    route,\n    subject,\n    body,\n    from,\n    task_type: route,\n  }\n}];"
      },
      "id": "router-node",
      "name": "Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
              "operation": "equal",
              "value2": "high"
            }
          ]
        }
      },
      "id": "switch-high",
      "name": "High Priority",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
              "operation": "equal",
              "value2": "sap"
            }
          ]
        }
      },
      "id": "switch-sap",
      "name": "SAP Team",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 250]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
              "operation": "equal",
              "value2": "database"
            }
          ]
        }
      },
      "id": "switch-database",
      "name": "DBA Team",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
              "operation": "equal",
              "value2": "network"
            }
          ]
