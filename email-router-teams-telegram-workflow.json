      },
      "id": "switch-it",
      "name": "IT Support",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 700]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.route }}",
              "operation": "equal",
              "value2": "app"
            }
          ]
        }
      },
      "id": "switch-app",
      "name": "App Support",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 850]
    },
    {
      "parameters": {
        "conditions": {
